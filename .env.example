# EPS Phoenix Environment Configuration Example
# Copy this file to .env and configure the values for your environment.

# Django Security & Core Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Authoritative PostgreSQL Database URL
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# If DATABASE_URL is not set or unavailable during local development, fallback SQLite will be used.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eps_phoenix_db

# CSRF Trusted Origins (comma-separated list for production)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Institution Details
INSTITUTION_NAME=Phoenix Institute of Technology
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us
