<script>
function inspectRoll(seq, regNum, status, statusDisplay, name, email, expires) {
    document.getElementById('modal-seq-badge').textContent = String(seq).padStart(2, '0');
    document.getElementById('modal-reg-num').textContent = regNum;

    const badge = document.getElementById('modal-status-badge');
    badge.textContent = statusDisplay;
    badge.className = 'badge ' + (
        status === 'assigned' ? 'badge--success' :
        status === 'pending' ? 'badge--warning' :
        status === 'reserved' ? 'badge--warning' :
        'badge--neutral'
    );

    const nameEl = document.getElementById('modal-student-name');
    const emailEl = document.getElementById('modal-student-email');
    const expRow = document.getElementById('modal-expires-row');
    const expVal = document.getElementById('modal-expires-val');

    nameEl.textContent = name || 'No student assigned yet';
    emailEl.textContent = email || 'Position is open for registration';

    if (status === 'reserved' && expires) {
        expRow.style.display = 'block';
        expVal.textContent = expires;
    } else {
        expRow.style.display = 'none';
    }

    const modal = document.getElementById('roll-modal');
    modal.style.display = 'flex';
}

function closeRollModal() {
    document.getElementById('roll-modal').style.display = 'none';
}
</script>

