                    </label>
                    <textarea name="reason" cols="40" rows="3" class="lp-input" placeholder="Provide official justification for roll number reassignment..." required id="id_reason">
</textarea>
                    <small style="color: var(--text-muted); font-size: 11px;">Must be documented for institutional accreditation & exam audit</small>
                    
                </div>

