    <!-- Page Content & Alerts -->
    <main class="app-content" style="padding-top: var(--space-8);">
        

        
<div class="eps-auth-wrapper">
    <div class="auth-card auth-card--wide" role="main" aria-labelledby="register-title">
        
        <!-- Header Section -->
        <div class="auth-header">
            <div class="auth-logo-badge">EPS</div>
            <h1 class="auth-title" id="register-title">Create Your EPS Account</h1>
            <p class="auth-subtitle">Which type of account do you need? Choose your account type to get started with EPS.</p>
        </div>

        <!-- Server Error / Message Display -->
        

        

        <!-- Hidden input to track selected role -->
        <input type="hidden" id="selected-role-input" name="role" value="student">

        <!-- ==============================================================
             STEP 1: ROLE SELECTION SCREEN (Exactly 2 Public Roles)
             ============================================================== -->
        <div id="role-selection-screen" class="role-selection-grid" style="display: none;">
            <!-- Student Card -->
            <div class="role-card-btn is-selected" id="role-card-student" role="button" tabindex="0">
                <div class="role-card-indicator"><i data-lucide="check" class="lucide-icon icon-xs"></i></div>
                <div>
                    <div class="role-card-icon">
                        <i data-lucide="graduation-cap" class="lucide-icon icon-md"></i>
                    </div>
                    <h3 class="role-card-title">Student</h3>
                    <p class="role-card-desc">
                        Register as a student to access assigned examinations, complete readiness checks and view published results.
                    </p>
                </div>
                <div style="font-size: 12px; font-weight: 700; color: var(--auth-text-primary); display: flex; align-items: center; gap: 4px;">
                    <span>Continue as Student</span>
                    <i data-lucide="arrow-right" class="lucide-icon icon-xs"></i>
                </div>
            </div>

            <!-- Teacher Card -->
            <div class="role-card-btn " id="role-card-teacher" role="button" tabindex="0">
                <div class="role-card-indicator"><i data-lucide="check" class="lucide-icon icon-xs"></i></div>
                <div>
                    <div class="role-card-icon">
                        <i data-lucide="presentation" class="lucide-icon icon-md"></i>
                    </div>
                    <h3 class="role-card-title">Teacher</h3>
                    <p class="role-card-desc">
                        Register as a teacher to create examinations, manage questions, monitor candidates and evaluate submissions.
                    </p>
                </div>
                <div style="font-size: 12px; font-weight: 700; color: var(--auth-text-primary); display: flex; align-items: center; gap: 4px;">
                    <span>Continue as Teacher</span>
                    <i data-lucide="arrow-right" class="lucide-icon icon-xs"></i>
                </div>
            </div>
        </div>

        <!-- Selected Role Status Bar (with Change Role trigger) -->
        <div id="active-role-bar" class="active-role-bar" >
            <div class="active-role-badge">
                <i data-lucide="shield-check" class="lucide-icon icon-xs" style="color: #10B981;"></i>
                <span>Selected Account Type: <span id="active-role-label">Student Account</span></span>
            </div>
            <button type="button" class="change-role-btn" id="change-role-btn">Change Role</button>
        </div>

        <!-- ==============================================================
             STEP 2A: STUDENT REGISTRATION FORM
             ============================================================== -->
        <div id="student-form-container" style="">
            <form method="post" action="/accounts/register/" novalidate id="student-reg-form">
                <input type="hidden" name="csrfmiddlewaretoken" value="NBkDJ5hmMz6Srmrwmb2Uum667viNYmQlYDrKTMZxc0y4TlkpSJDOWD1v05ztXL9C">
                <input type="hidden" name="role" value="student">

                <!-- 1. Full Name -->
                <div class="auth-form-group">
                    <label for="student-full-name" class="auth-label">
                        <span>1. Full Name</span>
                        <span class="required-dot">*</span>
                    </label>
                    <input type="text"
                           name="full_name"
                           id="student-full-name"
                           class="lp-input"
                           placeholder="Enter your legal full name"
                           value=""
                           required>
                    
                </div>

                <!-- 2. Course / Department -->
                <div class="auth-form-group">
                    <label for="student-course-select" class="auth-label">
                        <span>2. Course / Department</span>
                        <span class="required-dot">*</span>
                    </label>
                    <select name="course" id="student-course-select" class="lp-select" required>
                        <option value="">Select Course / Academic Programme</option>
                        
                            <option value="2" >
                                B.Sc Computer Science (B.Sc CS) — Computer Science
                            </option>
                        
                            <option value="1" >
                                Bachelor of Computer Applications (BCA) — Computer Applications
                            </option>
                        
                    </select>
                    
                </div>

                <!-- 3. Roll Number (Filtered Searchable Institutional Enrollment Record) -->
                <div class="auth-form-group">
                    <label for="student-roll-input" class="auth-label">
                        <span>3. Roll Number (Institutionally Enrolled)</span>
                        <span class="required-dot">*</span>
                    </label>
                    <div style="position: relative;">
                        <input type="text"
                               name="roll_number"
                               id="student-roll-input"
                               class="lp-input"
                               placeholder="Select or enter your enrolled roll number (e.g. BCA202601)"
                               value=""
                               autocomplete="off"
                               required>
                        <!-- Dynamic Dropdown -->
                        <div id="roll-lookup-dropdown" class="roll-lookup-dropdown" style="display: none;"></div>
                    </div>
                    <div id="roll-status-badge">
                        
                            <span class="auth-field-status is-checking" style="font-size: 11.5px; color: var(--auth-text-muted);">
                                Select your course above to view and verify eligible enrolled roll numbers.
                            </span>
                        
                    </div>
                </div>

                <!-- 4. Semester (Dropdown: Semester 1 to 8) -->
                <div class="auth-form-group">
                    <label for="student-semester-select" class="auth-label">
                        <span>4. Semester</span>
                        <span class="required-dot">*</span>
                    </label>
                    <select name="semester" id="student-semester-select" class="lp-select" required>
                        <option value="">Select Semester</option>
                        <option value="1" >Semester 1</option>
                        <option value="2" >Semester 2</option>
                        <option value="3" >Semester 3</option>
                        <option value="4" >Semester 4</option>
                        <option value="5" >Semester 5</option>
                        <option value="6" >Semester 6</option>
                        <option value="7" >Semester 7</option>
                        <option value="8" >Semester 8</option>
                    </select>
                    
                </div>

                <!-- 5. Username (Real-time Debounced Validation) -->
                <div class="auth-form-group">
                    <label for="student-username-input" class="auth-label">
                        <span>5. Username</span>
                        <span class="required-dot">*</span>
                    </label>
                    <input type="text"
                           name="username"
                           id="student-username-input"
                           class="lp-input"
                           placeholder="Choose a unique username"
                           value=""
                           autocomplete="username"
                           required>
                    <div id="student-username-status">
                        
                    </div>
                </div>

                <!-- 6. Email Address (Mandatory & Validated) -->
                <div class="auth-form-group">
                    <label for="student-email-input" class="auth-label">
                        <span>6. Email Address</span>
                        <span class="required-dot">*</span>
                    </label>
                    <input type="email"
                           name="email"
                           id="student-email-input"
                           class="lp-input"
                           placeholder="student@institution.edu"
                           value=""
                           autocomplete="email"
                           required>
                    <div id="student-email-status">
                        
                    </div>
                </div>

                <!-- 7. Password (Real-time Requirements & Strength Meter) -->
                <div class="auth-form-group">
                    <label for="student-password1-input" class="auth-label">
                        <span>7. Password</span>
                        <span class="required-dot">*</span>
                    </label>
                    <div class="auth-input-wrapper">
                        <input type="password"
                               name="password1"
                               id="student-password1-input"
                               class="lp-input"
                               placeholder="Create a strong password"
                               autocomplete="new-password"
                               required>
                        <button type="button" class="password-toggle-btn" data-target="student-password1-input" aria-label="Toggle password visibility">
                            <i data-lucide="eye" class="lucide-icon icon-sm"></i>
                        </button>
                    </div>

                    <!-- Live Password Checklist Box -->
                    <div class="password-checklist-box">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                            <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--auth-text-muted);">
                                Password Requirements
                            </span>
                            <span id="student-pass-strength-text" style="font-weight: 700; font-size: 11.5px;"></span>
                        </div>
                        <div class="password-strength-meter">
                            <div id="student-pass-meter" class="password-strength-bar"></div>
                        </div>
                        <ul class="password-rules-list">
                            <li id="student-rule-len" class="password-rule-item" data-label="Minimum 8 characters">
                                <i data-lucide="circle" class="lucide-icon icon-xs"></i> Minimum 8 characters
                            </li>
                            <li id="student-rule-upper" class="password-rule-item" data-label="One uppercase letter (A-Z)">
                                <i data-lucide="circle" class="lucide-icon icon-xs"></i> One uppercase letter
                            </li>
                            <li id="student-rule-lower" class="password-rule-item" data-label="One lowercase letter (a-z)">
                                <i data-lucide="circle" class="lucide-icon icon-xs"></i> One lowercase letter
                            </li>
                            <li id="student-rule-num" class="password-rule-item" data-label="One number (0-9)">
                                <i data-lucide="circle" class="lucide-icon icon-xs"></i> One number
                            </li>
                            <li id="student-rule-special" class="password-rule-item" data-label="One special character (!@#...)">
                                <i data-lucide="circle" class="lucide-icon icon-xs"></i> One special character
                            </li>
                        </ul>
                    </div>
                    
                </div>

                <!-- 8. Confirm Password -->
                <div class="auth-form-group">
                    <label for="student-password2-input" class="auth-label">
                        <span>8. Confirm Password</span>
                        <span class="required-dot">*</span>
                    </label>
                    <div class="auth-input-wrapper">
                        <input type="password"
                               name="password2"
                               id="student-password2-input"
                               class="lp-input"
                               placeholder="Re-enter your password to confirm"
                               autocomplete="new-password"
                               required>
                        <button type="button" class="password-toggle-btn" data-target="student-password2-input" aria-label="Toggle password visibility">
                            <i data-lucide="eye" class="lucide-icon icon-sm"></i>
                        </button>
                    </div>
                    <div id="student-confirm-status">
                        
                    </div>
                </div>

                <!-- Submit CTA -->
                <button type="submit" class="auth-submit-btn" id="student-submit-btn">
                    <span>Create Student Account</span>
                    <i data-lucide="arrow-right" class="lucide-icon icon-sm"></i>
                </button>
            </form>
        </div>

        <!-- ==============================================================
