                </div>

                <!-- 5. Email Address -->
                <div class="auth-form-group">
                    <label for="teacher-email-input" class="auth-label">
                        <span>5. Email Address</span>
                        <span class="required-dot">*</span>
                    </label>
                    <input type="email"
                           name="email"
                           id="teacher-email-input"
                           class="lp-input"
                           placeholder="teacher@institution.edu"
                           value=""
                           autocomplete="email"
                           required>
                    <div id="teacher-email-status">
                        
                    </div>
                </div>

                <!-- 6. Password -->
                <div class="auth-form-group">
                    <label for="teacher-password1-input" class="auth-label">
                        <span>6. Password</span>
                        <span class="required-dot">*</span>
                    </label>
                    <div class="auth-input-wrapper">
                        <input type="password"
                               name="password1"
                               id="teacher-password1-input"
                               class="lp-input"
                               placeholder="Create a strong password"
                               autocomplete="new-password"
                               required>
                        <button type="button" class="password-toggle-btn" data-target="teacher-password1-input" aria-label="Toggle password visibility">
                            <i data-lucide="eye" class="lucide-icon icon-sm"></i>
                        </button>
                    </div>

                    <!-- Checklist Box -->
                    <div class="password-checklist-box">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                            <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--auth-text-muted);">
                                Password Requirements
                            </span>
                            <span id="teacher-pass-strength-text" style="font-weight: 700; font-size: 11.5px;"></span>
                        </div>
                        <div class="password-strength-meter">
                            <div id="teacher-pass-meter" class="password-strength-bar"></div>
                        </div>
                        <ul class="password-rules-list">
                            <li id="teacher-rule-len" class="password-rule-item" data-label="Minimum 8 characters">
                                <i data-lucide="circle" class="lucide-icon icon-xs"></i> Minimum 8 characters
                            </li>
