                    </select>
                    
                </div>

                <!-- 4. Username -->
                <div class="auth-form-group">
                    <label for="teacher-username-input" class="auth-label">
                        <span>4. Username</span>
                        <span class="required-dot">*</span>
                    </label>
                    <input type="text"
