# Git ignore for EPS Phoenix (Examination Proctoring System Phoenix)

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.*
!.env.example

# Databases
*.sqlite3
*.db
local_db/

# Media & static uploads
media/*
!media/.gitkeep
staticfiles/*
!staticfiles/.gitkeep
static_root/

# Logs
*.log
logs/

# Testing & coverage
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# Editor & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
